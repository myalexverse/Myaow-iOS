# ==============================================================================
# 🐱 MYAOW RELAY SERVER - CONFIGURACIÓN DE ENTORNO
# ==============================================================================

# Puerto del servidor Relay
PORT=8080

# ------------------------------------------------------------------------------
# ☁️ ALMACENAMIENTO CLOUDFLARE R2 (opcional; revisar cuotas y costos antes de activarlo)
# ------------------------------------------------------------------------------
# Para obtener estas credenciales:
# 1. Ve a tu panel de Cloudflare -> R2 Object Storage
# 2. Crea un bucket llamado 'myaow-media'
# 3. En 'Manage R2 API Tokens', genera un token con permisos de lectura y escritura
# 4. Descomenta y llena las siguientes líneas:

# R2_ACCOUNT_ID=tu_account_id_de_cloudflare
# R2_ACCESS_KEY_ID=tu_access_key_id
# R2_SECRET_ACCESS_KEY=tu_secret_access_key
# R2_BUCKET_NAME=myaow-media
# R2_PUBLIC_URL=https://media.myaow.app

# ------------------------------------------------------------------------------
# 🍎 APPLE PUSH NOTIFICATION SERVICE (APNs)
# ------------------------------------------------------------------------------
# APNS_KEY_ID=tu_key_id
# APNS_TEAM_ID=tu_team_id
# APNS_KEY_PATH=./AuthKey_XXXXXXXXXX.p8
# APNS_TOPIC=com.ScendLabs.Myaow

# Llamadas y push: valores del entorno, nunca incluidos en la app.
# APNS_KEY_PATH debe ser la ruta absoluta a la clave .p8 montada como secreto.
# El cliente registra sandbox (Debug) o production (Release/TestFlight) por dispositivo.
# El entorno del gateway ya no está fijado a sandbox.
# TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp,turns:turn.example.com:5349?transport=tcp
# TURN_SHARED_SECRET=secreto_aleatorio_de_al_menos_32_caracteres_compartido_solo_con_coturn
