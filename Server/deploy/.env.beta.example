# Sin protocolo ni barras. DNS debe apuntar al servidor elegido.
API_DOMAIN=api-beta.myaow.odisseolabs.com
ACME_EMAIL=operator@example.com
# Fijar una versión/digest verificados al realizar el primer despliegue.
CADDY_IMAGE=caddy:2
APNS_TEAM_ID=REPLACE
APNS_KEY_ID=REPLACE
APNS_TOPIC=com.ScendLabs.Myaow
# Archivos fuera del repositorio, legibles por UID 1000 dentro del contenedor.
APNS_KEY_FILE=/secure/myaow/AuthKey.p8
TURN_SECRET_FILE=/secure/myaow/turn-secret.txt
TURN_URLS=turn:turn-beta.myaow.odisseolabs.com:3478?transport=udp,turn:turn-beta.myaow.odisseolabs.com:3478?transport=tcp,turns:turn-beta.myaow.odisseolabs.com:5349?transport=tcp
BETA_REGISTRATION_MODE=invite
BETA_MAX_USERS=30
